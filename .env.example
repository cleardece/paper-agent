# LLM
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# Storage
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=paper_agent
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Paper processing and search
MINERU_URL=http://localhost:8888
MINERU_BACKEND=pipeline
# 默认：每次解析结束立即停止本机 MinerU，释放模型内存；批量上传时可改为 300。
MINERU_IDLE_SHUTDOWN_SECONDS=0
MINERU_REQUIRE_ACCURATE_PARSE=true
# 可选的本机资源限制；留空以避免把某一台机器的配置强加给所有用户。
MINERU_MEMORY_LIMIT=
MINERU_CPU_LIMIT=
# 批量上传队列：全局始终串行；限制可按本机资源调整。
UPLOAD_BATCH_MAX_FILES=20
UPLOAD_MAX_FILE_MB=100
UPLOAD_QUEUE_MAX_PENDING=50
UPLOAD_JOB_RETENTION_DAYS=30
USE_MCP=true
MCP_ARXIV_URL=http://localhost:8060/sse
SEMANTIC_SCHOLAR_API_KEY=

# Docker bind-mount root; use a local path that is writable by Docker Desktop.
PA_DATA_ROOT=./.local-data
