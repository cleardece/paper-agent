# LLM
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# Storage
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=paper_agent
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Paper processing and search
MINERU_URL=http://localhost:8888
MINERU_BACKEND=pipeline
USE_MCP=true
MCP_ARXIV_URL=http://localhost:8060/sse
SEMANTIC_SCHOLAR_API_KEY=

# Docker bind-mount root; use a local path that is writable by Docker Desktop.
PA_DATA_ROOT=./.local-data
